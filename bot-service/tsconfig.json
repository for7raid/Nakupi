{
  "compilerOptions": {
    "target": "ES6",                          // Указывает целевую версию JavaScript
    "module": "commonjs",                     // Указывает модульную систему
    "strict": true,                           // Включает строгий режим
    "esModuleInterop": true,                  // Включает совместимость с модулями ES
    "skipLibCheck": true,                     // Пропускает проверку типов в файлах библиотек
    "forceConsistentCasingInFileNames": true, // Принуждает к единому регистру в именах файлов
    "outDir": "./dist",                       // Указывает выходную директорию для скомпилированных файлов
    "rootDir": "./src",                       // Указывает корневую директорию исходных файлов
    "baseUrl": "./",                          // Указывает базовый URL для разрешения модулей
    "paths": {
      "@/*": ["src/*"],
      "@domain/*": ["src/domain/*"],
      "@application/*": ["src/application/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@presentation/*": ["src/presentation/*"],
      "@config/*": ["src/config/*"],
      "@test/*": ["src/test/*"]
    },
    "types": ["node", "jest"]                // Добавляем типы Jest для распознавания в тестах
  },
  "include": [
    "src/**/*"                                // Включает все файлы в папке src
  ],
  "exclude": [
    "node_modules",                           // Исключает папку node_modules
    "**/*.test.ts"                            // Исключает файлы тестов
  ]
}