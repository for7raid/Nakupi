{
  "name": "nakupi",
  "version": "1.0.0",
  "description": "Сервис для управления списками покупок",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production npm run build && node -r tsconfig-paths/register dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "kill-port": "kill-port 3001 3002",
    "dev:clean": "npm run kill-port && npm run dev",
    "docker:build": "docker build -t nakupi-bot .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix"
  },
  "keywords": [
    "telegram",
    "bot",
    "shopping-list"
  ],
  "author": "",
  "license": "ISC",
  "_moduleAliases": {
    "@": "dist",
    "@domain": "dist/domain",
    "@application": "dist/application",
    "@infrastructure": "dist/infrastructure",
    "@presentation": "dist/presentation",
    "@config": "dist/config",
    "@test": "dist/test"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^8.1.0",
    "module-alias": "^2.2.3",
    "mongodb": "^6.9.0",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "telegraf-session-local": "^2.1.1",
    "typescript": "^5.6.3",
    "uuid": "^11.1.0",
    "winston": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/module-alias": "^2.0.4",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
